{
  "name": "slapshot-summit",
  "version": "1.0.0",
  "description": "Hockey x Snowboarding x Car Racing — a multiplayer three.js arcade game",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server/index.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.165.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.165.0",
    "@types/ws": "^8.5.10",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
